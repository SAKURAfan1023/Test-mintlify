{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TextIn 内容信息表",
  "description": "运营维护文章信息；标题和摘要读取对应文章，不需要重复填写。数组顺序即默认展示顺序。",
  "type": "object",
  "additionalProperties": false,
  "required": ["siteUrl", "news", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "siteUrl": { "type": "string", "format": "uri", "pattern": "^https://[a-zA-Z0-9.-]+(:[0-9]+)?$", "description": "站点公开域名，不带末尾斜杠。用于生成分享图片的完整 URL。" },
    "news": { "type": "array", "items": { "$ref": "#/definitions/news" } },
    "cases": { "type": "array", "items": { "$ref": "#/definitions/story" } }
  },
  "definitions": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "common": {
      "page": { "type": "string", "description": "文章路径，不带开头斜杠和 .mdx，例如 news/new-article。", "pattern": "^(news|cases)/[a-zA-Z0-9][a-zA-Z0-9_-]*$" },
      "date": { "type": "string", "format": "date", "description": "发布日期，YYYY-MM-DD。" },
      "product": { "$ref": "#/definitions/text", "description": "产品筛选项，例如 xParse、DocFlow。" },
      "cover": { "type": "string", "pattern": "^/images/[a-zA-Z0-9_./-]+\\.(webp|jpg|jpeg|svg)$", "description": "已上传的封面图片路径，推荐 WebP。" },
      "featured": { "type": "boolean", "description": "是否使用列表大卡片。每类最多一个。" }
    },
    "news": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "date", "category", "product", "cover", "readMinutes"],
      "properties": {
        "page": { "$ref": "#/definitions/common/page" },
        "date": { "$ref": "#/definitions/common/date" },
        "category": { "$ref": "#/definitions/text", "description": "新闻分类，例如 Engineering、Guides。" },
        "product": { "$ref": "#/definitions/common/product" },
        "cover": { "$ref": "#/definitions/common/cover" },
        "readMinutes": { "type": "integer", "minimum": 1, "description": "阅读分钟数。" },
        "featured": { "$ref": "#/definitions/common/featured" }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "date", "industry", "scenarios", "product", "cover", "customer", "metric"],
      "properties": {
        "page": { "$ref": "#/definitions/common/page" },
        "date": { "$ref": "#/definitions/common/date" },
        "industry": { "$ref": "#/definitions/text", "description": "所属行业。" },
        "scenarios": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/text" }, "description": "应用场景，可填写多个。" },
        "product": { "oneOf": [{ "$ref": "#/definitions/common/product" }, { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/definitions/common/product" } }], "description": "单个产品填字符串；同时使用多个产品时填数组，例如 [\"xParse\", \"DocFlow\"]。" },
        "cover": { "$ref": "#/definitions/common/cover" },
        "customer": { "$ref": "#/definitions/text", "description": "客户名称。" },
        "customerLogo": { "$ref": "#/definitions/common/cover", "description": "可选，客户 Logo 图片路径；只填写已确认的客户品牌素材，未公开客户不填写。" },
        "metric": {
          "type": "object", "additionalProperties": false, "required": ["value", "label"],
          "properties": { "value": { "$ref": "#/definitions/text" }, "label": { "$ref": "#/definitions/text" } },
          "description": "列表展示的成果数值和说明，必须有文章事实支撑。"
        },
        "featured": { "$ref": "#/definitions/common/featured" }
      }
    }
  }
}
